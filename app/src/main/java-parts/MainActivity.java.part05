        LinearLayout form = formLayout();
        EditText start = field(Integer.toString(eatingStartHour), "Eating starts hour (0–23)", InputType.TYPE_CLASS_NUMBER);
        EditText end = field(Integer.toString(eatingEndHour), "Eating ends hour (0–23)", InputType.TYPE_CLASS_NUMBER);
        form.addView(start); form.addView(end);
        new AlertDialog.Builder(this).setTitle("Daily eating window")
                .setMessage("Use local 24-hour clock hours. This sets a reminder window; it does not automatically start or end a fast.")
                .setView(form).setNegativeButton("Cancel", null).setPositiveButton("Save", (d, w) -> {
                    int s, e;
                    try { s = Integer.parseInt(start.getText().toString()); e = Integer.parseInt(end.getText().toString()); }
                    catch (Exception ex) { toast("Use whole hours from 0 to 23."); return; }
                    if (s < 0 || s > 23 || e < 0 || e > 23 || s == e) { toast("Choose different hours from 0 to 23."); return; }
                    eatingStartHour = s; eatingEndHour = e;
                    prefs.edit().putInt("eating_start_hour", s).putInt("eating_end_hour", e).apply();
                    renderPage();
                }).show();
    }

    private void toggleReminders() {
        if (remindersEnabled) {
            remindersEnabled = false;
            prefs.edit().putBoolean("reminders_enabled", false).apply();
            cancelReminder(1002); cancelReminder(1003);
            toast("Local reminders are off."); renderPage(); return;
        }
        if (Build.VERSION.SDK_INT >= 33 && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(new String[]{Manifest.permission.POST_NOTIFICATIONS}, REQ_NOTIFICATIONS);
            return;
        }
        remindersEnabled = true;
        prefs.edit().putBoolean("reminders_enabled", true).apply();
        if (fastStartedAtMs > 0L) scheduleFastEndReminder();
        scheduleEatingReminder();
        toast("Local reminders enabled."); renderPage();
    }

    @Override public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions, @NonNull int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (requestCode == REQ_NOTIFICATIONS) {
            if (grantResults.length > 0 && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
                remindersEnabled = true;
                prefs.edit().putBoolean("reminders_enabled", true).apply();
                if (fastStartedAtMs > 0L) scheduleFastEndReminder();
                scheduleEatingReminder();
                toast("Local reminders enabled.");
            } else {
                toast("Notification permission was not granted.");
            }
            renderPage();
        }
    }

    private void scheduleFastEndReminder() {
        if (!remindersEnabled || fastStartedAtMs == 0L) return;
        scheduleReminder(1002, fastStartedAtMs + fastingHours * HOUR_MS, "Fasting target reached", "Your " + fastingHours + "-hour timer has finished.");
    }

    private void scheduleEatingReminder() {
        if (!remindersEnabled) return;
        Calendar c = Calendar.getInstance();
        c.set(Calendar.HOUR_OF_DAY, eatingStartHour); c.set(Calendar.MINUTE, 0); c.set(Calendar.SECOND, 0); c.set(Calendar.MILLISECOND, 0);
        if (c.getTimeInMillis() <= System.currentTimeMillis()) c.add(Calendar.DAY_OF_YEAR, 1);
        scheduleReminder(1003, c.getTimeInMillis(), "Your planned eating window", "Your saved eating-window reminder is due.");
    }

    private void scheduleReminder(int requestId, long at, String title, String body) {
        try {
            Intent intent = new Intent(this, ReminderReceiver.class);
            intent.putExtra("title", title); intent.putExtra("body", body);
            PendingIntent pi = PendingIntent.getBroadcast(this, requestId, intent, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
            AlarmManager alarm = (AlarmManager) getSystemService(ALARM_SERVICE);
            if (alarm != null) alarm.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, Math.max(at, System.currentTimeMillis() + 1000L), pi);
        } catch (Exception ignored) { toast("Couldn't schedule that reminder on this device."); }
    }

    private void cancelReminder(int requestId) {
        Intent intent = new Intent(this, ReminderReceiver.class);
        PendingIntent pi = PendingIntent.getBroadcast(this, requestId, intent, PendingIntent.FLAG_NO_CREATE | PendingIntent.FLAG_IMMUTABLE);
        if (pi != null) {
            AlarmManager alarm = (AlarmManager) getSystemService(ALARM_SERVICE);
            if (alarm != null) alarm.cancel(pi);
            pi.cancel();
        }
    }

